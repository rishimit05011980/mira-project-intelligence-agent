    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet tasks = [];\n\nfor (const item of items) {\n\n  if (item.json.task_id) {\n    tasks.push({\n      task_id: item.json.task_id,\n      task_name: item.json.task_name,\n      status: item.json.status,\n      sprint: item.json.sprint,\n      assignee: item.json.assignee,\n      due_date: item.json.due_date,\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      context_type: \"STATUS\",\n      tasks: tasks,\n    },\n  },\n];"
      },
