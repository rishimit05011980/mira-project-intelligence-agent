    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet projectDescription = \"\";\nlet risks = [];\n\nfor (const item of items) {\n\n  if (item.json.data) {\n    projectDescription = item.json.data;\n  }\n\n  if (item.json.risk_id) {\n    risks.push({\n      risk_id: item.json.risk_id,\n      category: item.json.category,\n      risk_challenge: item.json.risk_challenge,\n      impact: item.json.impact,\n      mitigation_strategy: item.json.mitigation_strategy,\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      context_type: \"RISK\",\n      project_description: projectDescription,\n      risks: risks,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        192
      ],
      "id": "0dec01ef-0d0a-4134-b175-4f0dffa625d9",
      "name": "Risk Context Consolidator"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet projectDescription = \"\";\nlet timeline = [];\n\nfor (const item of items) {\n\n  if (item.json.data) {\n    projectDescription = item.json.data;\n  }\n\n  if (item.json.phase) {\n    timeline.push({\n      phase: item.json.phase,\n      phase_name: item.json.phase_name,\n      start_week: item.json.start_week,\n      end_week: item.json.end_week,\n      key_activities: item.json.key_activities,\n      milestones_deliverables: item.json.milestones_deliverables,\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      context_type: \"PLAN\",\n      project_description: projectDescription,\n      timeline: timeline,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
